@import "./tokens.wxss";

/* 视觉规格全部来自 设计画布/System.dc.html「夜里的暖」。
   px → rpx 一律 ×2（画板 390 宽，750rpx 基准下差 4%，看不出来）；
   边框的 1px 不换——细线的绝对细度比自适应重要。

   字号阶梯：36 标题 / 22 段首 / 19 正文 / 15 次级 / 13.5 标签（原 11 标签低于
   可读下限，凌晨三点认知窄化时读不清——PRD 视觉规格要的是大字号）
   强调色三个，各只做一件事：黄铜=品名与主入口描边、青玉=在场人数与一口水、
   陶土=急救线与「身体不太对」。 */

.view{
  padding:0 48rpx 32rpx;
  /* 顶上那团光。暖来自材质和光，不来自饱和度 */
  background:radial-gradient(120% 55% at 50% -10%, #251E17 0%, rgba(37,30,23,0) 62%), var(--n1);
  min-height:100vh;
}

/* ── 顶栏 ─────────────────────────────────────────── */
.nav{ display:flex; align-items:center; min-height:64rpx; margin-bottom:8rpx; }
/* 根屏没有返回键，那 64rpx 就不该白占——首屏每一行都在和「不用滑」抢空间 */
.nav.root{ min-height:0; margin-bottom:0; }
.navbtn{ font-size:26rpx; letter-spacing:.1em; color:var(--paper3); padding:10rpx 0; }

/* ── 文字五级 ───────────────────────────────────────── */
/* 字号阶梯：31 标题 / 21 段首 / 17.7 正文 / 14.6 次级 / 13.5 标签
   苹方 300 字重在深色底上会发虚，标题一律 600——层次靠字重不靠字族。
   上一版标题是 72rpx 宋体 300 字重，那是"跟恐怖片一样"的主因。 */
.s-h{ font-family:var(--disp); font-size:50rpx; font-weight:600; line-height:1.3;
      letter-spacing:0; margin:16rpx 0 4rpx; display:block; }
.s-h2{ font-family:var(--disp); font-size:40rpx; font-weight:600; line-height:1.5;
       margin:26rpx 0 0; display:block; }
/* 38→32rpx：654rpx 宽里每行从 17 字变 20 字，「很/烫」这类拆词明显减少，
   home 那段 60 字的描述从 4 行变 3 行。16.6px 是中文正文的标准舒适区。
   justify 是中文段落的常规做法，右边不再参差 */
.s-p{ font-family:var(--body); font-size:32rpx; font-weight:400; line-height:1.8;
      margin:20rpx 0 0; display:block; text-align:justify; }
.s-s{ font-size:28rpx; line-height:1.85; color:var(--paper2); margin:20rpx 0 0; display:block;
      text-align:justify; }
.s-ti{ font-size:26rpx; letter-spacing:.22em; color:var(--paper3); margin:34rpx 0 8rpx; }
/* 品名——全屏最暖的东西，用得最省 */
/* 品名的字体本来是 --disp（无衬线），也就是和正文、按钮、标题同一个字族，
   只是更大更金 —— 她说"太丑了"。问题不是字丑，是品名没有自己的字：
   一个词只靠字号和颜色区分，读起来就是"一行被放大的正文"。
   改成 --hand（行楷）：牌面正中那个名字（.pname）本来就是这个字族，
   首页这一行是那张牌的入口，两处同字才是同一件东西。 */
.s-food{ font-family:var(--hand); font-size:58rpx; font-weight:400; color:var(--brass);
         letter-spacing:.06em; line-height:1.42;
         margin:6rpx 0 0; display:block; }
/* 引文卡：楷体有手写起伏，像便签不像医嘱。只用在这里——大标题用楷体会散 */
.s-box{ background:var(--n2); border-radius:14rpx; padding:26rpx 32rpx 28rpx; margin:26rpx 0 0;
        font-family:var(--hand); font-size:36rpx; line-height:1.8; display:block;
        border:1px solid var(--hair2); }
.s-num{ font-family:var(--disp); font-size:32rpx; color:var(--jade); margin:16rpx 0 0; display:block; }
.s-hr{ border:none; border-top:1px solid var(--hair2); margin:34rpx 0 6rpx; }

/* ── 按钮四级：主入口 70 / 分岔 64 / 次级 46，触区下限 44 ────────── */
.s-b{
  display:flex; align-items:center; justify-content:center; text-align:center;
  min-height:104rpx; padding:26rpx 32rpx; margin:22rpx 0 0;
  border:1px solid var(--hair); border-radius:14rpx;
  background:linear-gradient(168deg, #26201A, #1D1813);
  font-family:var(--disp); font-size:38rpx; color:var(--paper);
}
.s-b.big{
  min-height:120rpx; padding:28rpx 32rpx; font-size:38rpx; margin-top:26rpx;
  border-color:rgba(201,160,99,.42);
  background:linear-gradient(165deg, #2E251C, #231D16);
  box-shadow:0 14rpx 30rpx -18rpx rgba(0,0,0,.9), inset 0 1px 0 rgba(244,237,227,.05);
}
/* 青玉只给一口水；陶土只给急救线与「身体不太对」，低饱和，不与主入口争视觉 */
.s-b.cl{ min-height:104rpx; padding:30rpx; font-family:var(--body); font-size:30rpx;
         background:none; border-color:rgba(140,193,170,.32); color:var(--jade); }
.s-b.dg{ min-height:104rpx; padding:30rpx; font-size:34rpx;
         background:none; border-color:rgba(203,126,98,.5); color:var(--clay); }
.s-b.flat{ margin:0; flex:1; }

.s-q{
  display:flex; align-items:center; justify-content:space-between; gap:16rpx;
  /* 原来是 158rpx 高的卡片，三个并排吃掉六成屏，把主入口「我现在不太好」挤出首屏。
     这几个是次级入口（记录类），本来就不该和主动作一样重：改成列表行，
     分隔靠底部细线不靠卡片边框——等大圆角矩形连着堆才是那股 AI 味的来源。 */
  min-height:0; padding:22rpx 4rpx; margin:0;
  border:none; border-bottom:1px solid var(--hair2); border-radius:0; background:none;
  font-size:30rpx; color:var(--paper2); text-align:left;
}
.s-pair{ display:flex; gap:16rpx; margin:16rpx 0 0; }
.s-pair .s-q{ margin:0; flex:1; justify-content:center; }

.s-row{ display:flex; justify-content:space-between; align-items:baseline; gap:20rpx; line-height:1.45;
        border-bottom:1px solid var(--hair2); padding:15rpx 0; }
.rk{ font-family:var(--disp); font-size:32rpx; }
.rv{ font-size:28rpx; color:var(--paper3); text-align:right; flex:none; max-width:54%;
     line-height:1.6; }

/* 横排一行：竖排两行要 184rpx，横排 106rpx。急救线必须在首屏可见，
   省下来的高度正好抵掉它从折叠区搬出来的成本 */
.s-foot{ margin-top:24rpx; padding-top:20rpx; border-top:1px solid var(--hair2);
         display:flex; flex-direction:row; justify-content:space-between; gap:20rpx; }
/* 急救线在底部——顶部会被当标题跳过，底部在拇指区 */
.footbtn{ font-size:28rpx; color:var(--clay); padding:8rpx 0; letter-spacing:.04em; }

/* ── 六格：本身就是入口，不需要文字标签 ──────────────────────
   空格用虚线，不用红色不用感叹号。无连续天数、无百分比、无月历 */
.cells{ display:flex; gap:12rpx; margin:20rpx 0 0; }
.cell{ flex:1; height:64rpx; border-radius:12rpx; display:block;
       border:1px solid rgba(244,237,227,.22); }
.cell.on{ border-color:rgba(140,193,170,.7); background:rgba(140,193,170,.07); }
.cell.e{ border-style:dashed; border-color:rgba(244,237,227,.10); }

/* ── 词 chip 44：颜色只用来认出是哪个词，不用来说它值多少 ───────── */
.words{ display:flex; flex-wrap:wrap; gap:14rpx; margin:20rpx 0 0; }
.word{ display:inline-flex; align-items:center; justify-content:center; gap:10rpx;
       min-height:88rpx; padding:16rpx 28rpx; border-radius:44rpx;
       border:1px solid rgba(244,237,227,.13); font-size:30rpx; color:var(--paper); }
.dot{ width:18rpx; height:18rpx; border-radius:50%; display:block; }

/* ── 想吃点什么样的：五支，「说不上来」跨两列 ───────────────── */
.pick{ display:flex; flex-wrap:wrap; gap:18rpx; margin:20rpx 0 0; }
.pickbtn{ display:flex; align-items:center; justify-content:center; text-align:center;
          flex:1 1 44%; min-height:104rpx; padding:24rpx 20rpx;
          border:1px solid rgba(244,237,227,.16); border-radius:14rpx;
          font-family:var(--disp); font-size:34rpx; color:var(--paper); letter-spacing:.02em; }
.pickbtn.wide{ flex:1 1 100%; font-size:30rpx; color:var(--paper2); }

/* ── 在场人数：全屏唯一会自己变的东西 ─────────────────────── */
.online{ font-size:28rpx; letter-spacing:.1em; color:var(--jade); text-align:right;
         margin:4rpx 0 0; }

.player{ display:flex; align-items:center; gap:20rpx; margin:24rpx 0 0;
         min-height:104rpx; padding:26rpx 30rpx; background:var(--n2);
         border:1px solid var(--hair); border-radius:14rpx; }
.player.on{ border-color:rgba(140,193,170,.45); }
.pl-ico{ color:var(--jade); font-size:26rpx; }
.pl-t{ font-size:26rpx; color:var(--paper2); flex:none; }
.pl-bar{ flex:1; height:2px; background:var(--hair); border-radius:12rpx; position:relative; }
.pl-fill{ position:absolute; left:0; top:0; height:100%; background:var(--jade);
          border-radius:12rpx; transition:width 12s linear; }

/* ── 潮汐：产品的中心隐喻，也是名字的来源。两端淡出 ──────────── */
/* 环境层。fixed 到屏底，内容层 .page 压在它上面。
   高潮那一态占得最高——水该显得快要漫上来。 */
.tide-bg{ position:fixed; left:0; right:0; bottom:0; z-index:0; pointer-events:none;
          width:100%; height:52vh; opacity:0; animation:tidein 1.6s ease-out forwards; }
.tide-bg.peak{ height:68vh; }
.tide-bg.ebb{ height:58vh; }
@keyframes tidein{ to{ opacity:1 } }
.page{ position:relative; z-index:1; }

/* 三张卡：一个念头 + 它的解释。
   原来是三个 h2 加三段 p 连着排，读起来像条款（她说"又像是规则怪谈一样"）。
   摞成一列条文的观感来自两件事：标题和正文同宽同色块、以及没有边界。
   所以给每条一个自己的框、一个小圆点起头，念头本身用正文的字号不用标题的
   ——它是她心里的一句话，不是一条法规。 */
.c3{ margin:22rpx 0 0; }
.c3card{ position:relative; margin-top:16rpx; padding:24rpx 26rpx 26rpx 44rpx;
         border-radius:16rpx; background:var(--n2);
         border:1px solid var(--hair2); }
.c3dot{ position:absolute; left:22rpx; top:34rpx; width:10rpx; height:10rpx;
        border-radius:50%; background:var(--brass); opacity:.7; }
.c3t{ display:block; font-family:var(--disp); font-size:34rpx; font-weight:600;
      color:var(--paper); line-height:1.45; }
.c3p{ display:block; margin-top:10rpx; font-size:31rpx; line-height:1.78;
      color:var(--paper2); text-align:justify; }

/* 食物色带。eat 屏顶上那一条：那一支口味的颜色 + 同一套麻点质感。
   不放照片、不做识别——PRD：识别通往量化，技术上做得到、产品上不做。
   所以"质感"全部由颜色、受光斑和麻点合成。 */
.fband{ position:relative; height:168rpx; margin:18rpx 0 4rpx; border-radius:16rpx;
        overflow:hidden; display:flex; align-items:flex-end; padding:20rpx 26rpx;
        background:
          radial-gradient(26% 34% at 66% 26%, rgba(255,255,255,.11), transparent 70%),
          radial-gradient(20% 26% at 32% 62%, rgba(0,0,0,.16), transparent 72%),
          radial-gradient(86% 70% at 24% 12%, var(--lit), transparent 62%),
          linear-gradient(168deg, rgba(0,0,0,.06), rgba(0,0,0,.42) 100%),
          var(--deep);
        box-shadow:inset 0 1px 0 rgba(255,255,255,.12),
                   inset 0 0 0 1px rgba(244,237,227,.09); }
.fgrain{ position:absolute; left:0; top:0; right:0; bottom:0; opacity:.45;
  background-image:
    radial-gradient(rgba(0,0,0,.20) 0.8px, transparent 0.9px),
    radial-gradient(rgba(255,255,255,.12) 0.7px, transparent 0.8px);
  background-size:7px 7px, 12px 12px; background-position:0 0, 4px 6px; }
.ftext{ position:relative; z-index:2; font-family:var(--hand); font-size:38rpx;
        color:var(--paper); letter-spacing:.1em;
        text-shadow:0 2rpx 10rpx rgba(0,0,0,.55); }

/* two 的两支。左边是那句话，右边是它的样子，末尾一个 ›——
   原来这两行是静态的 row，点不动，而屏上写着"这两种需要的建议正好相反"
   却没有那两份建议。 */
.twoway{ margin:24rpx 0 0; }
.tw{ display:flex; align-items:baseline; gap:16rpx; padding:24rpx 4rpx;
     border-bottom:1px solid var(--hair2);
     transition:opacity .16s ease, transform .16s ease; }
.twt{ font-size:33rpx; color:var(--paper); flex:none; }
.twh{ font-size:26rpx; color:var(--paper3); flex:1; text-align:right; line-height:1.5; }

/* 清单。勾选框是方的不是圆的——圆的读成单选，而这三条可以都勾。
   勾中不用对号（那是评分的符号），用一个填进去的方块。 */
.checks{ margin:22rpx 0 0; }
.chk{ display:flex; align-items:flex-start; gap:20rpx; padding:22rpx 4rpx;
      border-bottom:1px solid var(--hair2);
      transition:opacity .16s ease, transform .16s ease; }
.cbox{ flex:none; width:34rpx; height:34rpx; margin-top:4rpx; border-radius:6rpx;
       border:1px solid rgba(244,237,227,.30);
       display:flex; align-items:center; justify-content:center;
       transition:border-color .2s ease, background .2s ease; }
.cmark{ width:16rpx; height:16rpx; border-radius:3rpx; background:transparent;
        transition:background .2s ease, transform .2s ease; transform:scale(.6); }
.chk.on .cbox{ border-color:rgba(201,160,99,.65); background:rgba(201,160,99,.10); }
.chk.on .cmark{ background:var(--brass); transform:scale(1); }
.ctext{ font-size:32rpx; line-height:1.5; color:var(--paper); }
.gatego{ margin-top:30rpx; }

/* 到点叫我。排上了就换文案，再点取消 */
.remind.on{ border-color:rgba(140,193,170,.5); color:var(--jade); }

/* ── 屏级排版例外 ──────────────────────────────────────────
   .view 带 s-<屏id>，个别屏可以有自己的节奏。

   entry 只有一句问话加两个选项。上一版用 flex + margin-top:auto 撑开，
   但 :first-of-type 在小程序里靠不住（WXSS 对伪类支持有限），
   撑没撑开全看运气。改成给整屏一个下沉的内边距 + 逐块加大间距，
   不依赖任何伪类。 */
/* flex 列 + 一个 flex:1 的空档，把选项压到拇指区。
   PRD：全部操作在拇指范围内，可能躺着用、桌下用。 */
.s-entry .page{ padding-top:56rpx; display:flex; flex-direction:column;
                min-height:calc(100vh - 240rpx); }
.s-gap{ flex:1; min-height:56rpx; }
.s-entry .s-h{ font-size:54rpx; line-height:1.42; margin:0 0 12rpx; }
.s-entry .s-b{ margin-top:40rpx; min-height:136rpx; font-size:36rpx;
               background:linear-gradient(166deg, rgba(46,37,28,.86), rgba(30,25,19,.86));
               border-color:rgba(244,237,227,.14);
               backdrop-filter:blur(2px); }
.s-entry .s-s{ margin-top:64rpx; }
.s-entry .s-q{ border-bottom:none; }

/* ── 入口屏的雾 ────────────────────────────────────────────
   PRD 说深色为底、低对比低饱和，也说"刻意的朴素"——所以雾要非常淡，
   淡到你不确定它在动。三层不同速度、不同方向，一层 70 秒一层 96 秒一层 124 秒，
   周期互质，所以看不出循环。
   这是全屏唯一一处纯装饰的动效，只在入口屏出现：那是唯一一个
   还没进入任何流程、可以慢一点的时刻。 */
.haze{ position:fixed; left:0; top:0; right:0; bottom:0; z-index:0;
       pointer-events:none; overflow:hidden; }
.hz{ position:absolute; border-radius:50%; }
.hz.h1{ left:-24%; top:-14%; width:96%; height:52%;
        background:radial-gradient(closest-side, rgba(201,160,99,.12), transparent 72%);
        animation:drift1 70s ease-in-out infinite; }
.hz.h2{ right:-30%; top:22%; width:104%; height:58%;
        background:radial-gradient(closest-side, rgba(140,193,170,.075), transparent 74%);
        animation:drift2 96s ease-in-out infinite; }
.hz.h3{ left:-14%; bottom:-22%; width:120%; height:60%;
        background:radial-gradient(closest-side, rgba(203,126,98,.07), transparent 76%);
        animation:drift3 124s ease-in-out infinite; }
@keyframes drift1{ 0%,100%{ transform:translate(0,0) scale(1) }
  34%{ transform:translate(9%,5%) scale(1.1) } 68%{ transform:translate(-5%,9%) scale(.96) } }
@keyframes drift2{ 0%,100%{ transform:translate(0,0) scale(1) }
  40%{ transform:translate(-11%,-6%) scale(1.13) } 72%{ transform:translate(6%,7%) scale(.94) } }
@keyframes drift3{ 0%,100%{ transform:translate(0,0) scale(1.04) }
  46%{ transform:translate(7%,-8%) scale(.95) } 78%{ transform:translate(-8%,-3%) scale(1.12) } }

/* ── 七只动物 ──────────────────────────────────────────────
   用三条线／弧勾出形态的特征，不画完整的动物：
   犀牛＝低头前冲的角　梗犬＝竖着的耳朵和短腿　鸵鸟＝埋下去的长颈
   袋鼠＝前抱的育儿袋　水母＝伞盖和垂须　海豚＝并行的两道弧
   圣伯纳犬＝厚重的坐姿
   emoji 不用：craft-floor 明确禁"用 Unicode 字形顶替图标系统"，
   而且同一个 emoji 在安卓和 iOS 上是两种画风。 */
.beasts{ display:flex; flex-wrap:wrap; gap:14rpx; margin:24rpx 0 0; }
.bcard{ flex:0 0 calc((100% - 14rpx) / 2); box-sizing:border-box;
        min-height:186rpx; padding:18rpx 20rpx 16rpx; border-radius:16rpx;
        border:1px solid var(--hair2); background:var(--n2); position:relative;
        display:flex; flex-direction:column; justify-content:flex-end; overflow:hidden;
        transition:opacity .16s ease, transform .16s ease; }
/* 理想的那两张：一层极淡的光，不是描边——描边会读成"选中" */
.bcard.ideal{ background:
    radial-gradient(72% 60% at 70% 24%, rgba(201,160,99,.13), transparent 70%), var(--n2);
  border-color:rgba(201,160,99,.30);
  box-shadow:inset 0 0 26rpx -6rpx rgba(201,160,99,.22); }
.bt{ font-size:29rpx; color:var(--paper); line-height:1.4; position:relative; z-index:2; }
.ba{ font-size:24rpx; color:var(--paper3); margin-top:4rpx; letter-spacing:.06em;
     position:relative; z-index:2; }

/* 线条本体：SVG stroke 走 background-image 的 data URI。
   一开始用 CSS 边框弧拼形态，在 54px 的格子里完全读不出来——
   border-radius 只能画矩形和椭圆，勾不出轮廓。SVG 是矢量的，多小都清楚。
   小程序不支持 <svg> 标签，但 WXSS 的 background 认 data URI。
   只勾特征，不画完整的动物：
   犀牛＝低头的背线加前冲的角　梗犬＝竖耳方头短腿　鸵鸟＝圆身加埋下去的长颈
   袋鼠＝直立的身加前抱的袋　水母＝伞盖加三道垂须
   海豚＝并行的两道弧（一起走）　圣伯纳犬＝厚重的坐姿、重心压得很低（不慌） */
.bart{ position:absolute; right:14rpx; top:12rpx; width:112rpx; height:112rpx;
       opacity:.42; background-repeat:no-repeat; background-position:center;
       background-size:100% 100%; }
.bart.big{ position:relative; right:auto; top:auto; width:190rpx; height:190rpx;
           margin:10rpx auto 2rpx; opacity:.62; }
/* 理想的那两张：线条本身不换色，靠一层金光染——换色会让它读成"选中" */
.bcard.ideal .bart, .bhead.ideal .bart{ opacity:.72;
  filter:drop-shadow(0 0 8rpx rgba(224,191,140,.75)) drop-shadow(0 0 20rpx rgba(201,160,99,.35)); }
.a-rhino .bart{ background-image:url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 80 80%22%3E%3Cpath d=%22M6 46C10 27 26 20 45 22c11 1 17 8 19 16M62 30l12-9-4 14M18 62h40%22 fill=%22none%22 stroke=%22%23BDB1A1%22 stroke-width=%222.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E"); }
.a-terrier .bart{ background-image:url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 80 80%22%3E%3Cpath d=%22M20 32l3-15 9 11M48 28l7-12 4 15M17 31h46v22H17zM26 53v9M54 53v9%22 fill=%22none%22 stroke=%22%23BDB1A1%22 stroke-width=%222.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E"); }
.a-ostrich .bart{ background-image:url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 80 80%22%3E%3Cpath d=%22M32 56a16 15 0 1 0 32 0 16 15 0 1 0-32 0M36 46C24 42 16 32 20 24c3-6 10-5 11 1 1 4-3 7-6 5M30 70v6M50 70v6%22 fill=%22none%22 stroke=%22%23BDB1A1%22 stroke-width=%222.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E"); }
.a-kangaroo .bart{ background-image:url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 80 80%22%3E%3Cpath d=%22M46 16c6 0 9 4 9 10l-1 20c0 6-5 9-11 8M44 26c-7 1-11 6-11 13 0 6 3 10 8 12M44 54L16 74M36 40h14%22 fill=%22none%22 stroke=%22%23BDB1A1%22 stroke-width=%222.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E"); }
.a-jelly .bart{ background-image:url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 80 80%22%3E%3Cpath d=%22M19 37a21 17 0 0 1 42 0zM28 39c-2 12 2 18 0 26M40 39c-2 14 2 20 0 28M52 39c-2 12 2 18 0 26%22 fill=%22none%22 stroke=%22%23BDB1A1%22 stroke-width=%222.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E"); }
.a-dolphin .bart{ background-image:url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 80 80%22%3E%3Cpath d=%22M9 47C22 30 45 26 63 34l8-9-5 15M17 60C30 45 51 41 67 47%22 fill=%22none%22 stroke=%22%23BDB1A1%22 stroke-width=%222.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E"); }
.a-stbernard .bart{ background-image:url("data:image/svg+xml,%3Csvg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 80 80%22%3E%3Cpath d=%22M26 31a15 13 0 0 1 29 0l4 26c0 9-38 9-38 0zM19 66h42%22 fill=%22none%22 stroke=%22%23BDB1A1%22 stroke-width=%222.4%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22/%3E%3C/svg%3E"); }


/* 首页那张滋味卡：可点时右边给个 ›，整块有按下反馈 */
.tbody.go{ transition:opacity .16s ease, transform .16s ease; }
.tline{ display:flex; align-items:center; justify-content:space-between; gap:16rpx; }
.tline .chev{ font-size:32rpx; }

/* 食物名作为入口时：和列表行一样有个 ›，但保持它原来的字号字重 */
.s-food.fgo{ display:flex; align-items:center; justify-content:space-between; gap:16rpx;
             transition:opacity .16s ease, transform .16s ease; }
.s-food.fgo .chev{ font-size:32rpx; }

/* 正反问的两个选项。选中的那个有描边——原来选了没有任何变化 */
.s-pair{ display:flex; gap:14rpx; }
.s-pair .pr{ flex:1; justify-content:center; text-align:center;
             border:1px solid var(--hair2); border-radius:12rpx; padding:20rpx 8rpx;
             transition:border-color .2s ease, background .2s ease, opacity .16s ease, transform .16s ease; }
.s-pair .pr.on{ border-color:rgba(201,160,99,.5); background:rgba(201,160,99,.07);
                color:var(--paper); }

/* ── 一张牌 ────────────────────────────────────────────────
   她要"悬浮卡牌的效果，就是一张扑克牌，手写字的感觉，背景是食物的颜色和质感"。
   一张牌立得住靠四件事：
   1 比例 —— 扑克是 5:7，不是随便一个圆角矩形
   2 牌角标 —— 左上右下各一个小字，右下那个是倒的（真牌就是这样）
   3 悬浮 —— 轻微仰角 + 一道落在下方的影，不是贴在页面上
   4 材质 —— 那样食物的颜色打底，压一层纸纹，再来一道斜高光
   颜色从 data/daily.js 的 cardHue 来：每张牌是那样食物本身的颜色。 */
.deck{ display:flex; justify-content:center; padding:34rpx 0 22rpx;
       perspective:1200rpx; }
.pcard{ position:relative; width:480rpx; height:672rpx;   /* 5:7 */
        border-radius:26rpx; overflow:hidden;
        /* 底色不能收到写死的黑：那样食物的颜色就没了，整张牌只剩暗。
           改成 deep 打底、叠一层半透明黑压暗边角，色相始终透得出来。 */
        /* 食物质感：三块不规则的受光斑 + 一层细麻点，压在渐变上。
           纯渐变读起来像塑料卡；食物表面是不匀的——有焦的地方、有油亮的地方。 */
        background:
          /* ⚠️ 这里不再放纹理。上一版在这儿写了两组通用发丝线，
             结果 30 张牌只差颜色、纹理一模一样——她说"这不对，我要的是对应食物的质感"。
             纹理按食物的做法分了六族，见下面的 .tx-*。 */
          radial-gradient(28% 20% at 62% 30%, rgba(255,255,255,.10), transparent 70%),
          radial-gradient(22% 15% at 34% 62%, rgba(0,0,0,.16), transparent 72%),
          radial-gradient(18% 13% at 74% 66%, rgba(255,255,255,.07), transparent 74%),
          radial-gradient(84% 62% at 26% 14%, var(--lit), transparent 60%),
          radial-gradient(56% 40% at 84% 90%, var(--lit), transparent 68%),
          linear-gradient(166deg, rgba(0,0,0,0) 0%, rgba(0,0,0,.30) 62%, rgba(0,0,0,.54) 100%),
          var(--deep);
        box-shadow:
          0 2rpx 0 rgba(255,255,255,.16) inset,
          0 0 0 1px rgba(244,237,227,.14),
          0 34rpx 54rpx -22rpx rgba(0,0,0,.86),
          0 8rpx 18rpx -8rpx rgba(0,0,0,.6);
        transform:rotateX(5deg) translateZ(0);
        animation:cardin .62s cubic-bezier(.2,.7,.3,1) both; }
/* 进屏是"发牌"：从下方带一点旋转落定 */
@keyframes cardin{
  0%{ opacity:0; transform:rotateX(16deg) rotate(-4deg) translateY(56rpx) scale(.94) }
  100%{ opacity:1; transform:rotateX(5deg) rotate(0) translateY(0) scale(1) } }
/* ── 牌面质感，按食物的做法分六族 ──────────────────────────────
   做法决定表面：烙过的有焦痕、蒸过的有褶、汤是涟漪、米是粒、
   凉的挂水珠、糕是层。族的划分在 data/daily.js 的 cardTexFam，
   食物名 → 族名进 .pcard 的 class（tx-sear / tx-steam / …）。
   全部走渐变不用 canvas：牌有发牌动画，canvas 要等 selectorQuery
   拿到节点才画，会在动画之后闪一下。
   共同约束：alpha 全压在 .34 以下、线宽 1–2px。她要的是"简练的线条"，
   不是把牌面画满——牌面正中还得放得下品名和那段描述。 */
.pgrain{ position:absolute; left:0; top:0; right:0; bottom:0; }

/* 烙、煎、烤：不匀的焦痕 + 焦斑。
   ⚠️ 走错过一版：横线叠一组近垂直的"断线"想把它切成段，结果两组直接织成
      一张网格 —— 网格读作纱窗，比连续的横线更糟。
   正确的办法是**只用横向**，但三组的周期互质（11/17/29）、角度各差几度：
   三组叠起来的疏密自己漂移，看起来就是烙得不匀，而不是等距的线。
   规则感来自"只有一个周期"，不来自"是直线"。 */
.tx-sear .pgrain{ opacity:.66;
  background-image:
    radial-gradient(34% 24% at 24% 32%, rgba(0,0,0,.36), transparent 72%),
    radial-gradient(26% 18% at 76% 64%, rgba(0,0,0,.30), transparent 74%),
    radial-gradient(20% 13% at 54% 86%, rgba(255,255,255,.11), transparent 76%),
    repeating-linear-gradient(3deg,  rgba(0,0,0,.22) 0 2px, transparent 2px 11px),
    repeating-linear-gradient(7deg,  rgba(0,0,0,.14) 0 1px, transparent 1px 17px),
    repeating-linear-gradient(-4deg, rgba(255,255,255,.07) 0 1px, transparent 1px 29px); }

/* 蒸：褶从顶上一圈圈收进去，再压一层水光。
   椭圆的 repeating-radial 圆心放在牌面上缘外，弧线就是包子顶那种收口。 */
.tx-steam .pgrain{ opacity:.72;
  background-image:
    repeating-radial-gradient(ellipse 128% 88% at 50% -12%,
      transparent 0 9px, rgba(255,255,255,.085) 9px 10px, transparent 10px 23px),
    radial-gradient(70% 34% at 46% 6%, rgba(255,255,255,.13), transparent 74%),
    radial-gradient(40% 22% at 66% 78%, rgba(0,0,0,.16), transparent 76%); }

/* 汤、浆、粥：两组不同周期的同心圈。周期 15px 与 23px，
   交叠处自己乱掉——单独一组读起来像靶子。 */
.tx-soup .pgrain{ opacity:.68;
  background-image:
    repeating-radial-gradient(circle at 43% 57%,
      transparent 0 14px, rgba(255,255,255,.075) 14px 15px, transparent 15px 30px),
    repeating-radial-gradient(circle at 62% 38%,
      transparent 0 22px, rgba(255,255,255,.05) 22px 23px, transparent 23px 46px),
    radial-gradient(56% 30% at 32% 18%, rgba(255,255,255,.11), transparent 72%); }

/* 粒：三种疏密的点阵。周期 5/9/14 互质，看不出是网格 */
.tx-grain .pgrain{ opacity:.66;
  background-image:
    radial-gradient(rgba(255,255,255,.16) 1.1px, transparent 1.2px),
    radial-gradient(rgba(0,0,0,.22) 0.9px, transparent 1px),
    radial-gradient(rgba(255,255,255,.09) 1.5px, transparent 1.6px);
  background-size:5px 5px, 9px 9px, 14px 14px;
  background-position:0 0, 2px 3px, 5px 1px; }

/* 冰、凉：几颗水珠，每颗左上一点高光（那一点才是"水"，不然就是麻点）+ 一层霜 */
.tx-chill .pgrain{ opacity:.8;
  background-image:
    radial-gradient(circle 9px at 26% 22%, rgba(255,255,255,.20), rgba(255,255,255,.04) 62%, transparent 72%),
    radial-gradient(circle 6px at 70% 30%, rgba(255,255,255,.22), transparent 74%),
    radial-gradient(circle 12px at 62% 70%, rgba(255,255,255,.15), rgba(255,255,255,.03) 60%, transparent 72%),
    radial-gradient(circle 5px at 34% 78%, rgba(255,255,255,.20), transparent 76%),
    radial-gradient(circle 7px at 82% 56%, rgba(255,255,255,.14), transparent 74%),
    radial-gradient(rgba(255,255,255,.07) 0.7px, transparent 0.8px);
  background-size:auto, auto, auto, auto, auto, 6px 6px; }

/* 糕、软：等距的横向层。两组错开半个周期，暗线在亮线下面，读作切面 */
.tx-soft .pgrain{ opacity:.6;
  background-image:
    repeating-linear-gradient(0deg, rgba(255,255,255,.055) 0 1px, transparent 1px 26px),
    repeating-linear-gradient(0deg, transparent 0 13px, rgba(0,0,0,.13) 13px 14px, transparent 14px 26px),
    radial-gradient(50% 30% at 30% 24%, rgba(255,255,255,.08), transparent 74%); }
/* 斜高光：牌面在光下会有一道 */
/* 斜高光改成慢慢扫过去的一道油光。静止的高光读作印刷品上的一道白，
   会动的才读作"这个表面是湿的／有油"。7.2 秒一轮，峰值 alpha 只有 .13——
   要的是余光里察觉到它动过，不是一道扫光特效。 */
.pgloss{ position:absolute; left:-30%; top:-20%; width:90%; height:150%;
  transform:rotate(19deg);
  background:linear-gradient(90deg, transparent, rgba(255,255,255,.10) 46%, transparent);
  animation:sheen 7.2s 1.1s cubic-bezier(.5,0,.5,1) infinite; }
@keyframes sheen{
  0%,  8% { transform:rotate(19deg) translateX(-46%); opacity:.35 }
  46%     { opacity:1 }
  92%,100%{ transform:rotate(19deg) translateX(118%); opacity:.35 }
}
/* 牌角标。右下那个是倒的 */
.pcorner{ position:absolute; font-family:var(--hand); font-size:26rpx;
          color:rgba(244,237,227,.72); letter-spacing:.06em; }
.pcorner.tl{ left:26rpx; top:22rpx; }
.pday{ display:block; text-align:center; font-size:25rpx; letter-spacing:.14em;
       color:var(--paper3); margin-bottom:6rpx; }
.pcorner.br{ right:26rpx; bottom:22rpx; transform:rotate(180deg); }
/* 牌面正中 */
.pmid{ position:absolute; left:44rpx; right:44rpx; top:50%; transform:translateY(-50%);
       display:flex; flex-direction:column; align-items:center; text-align:center; }
.pname{ font-family:var(--hand); font-size:64rpx; font-weight:400; color:var(--paper);
        letter-spacing:.08em; line-height:1.3;
        text-shadow:0 2rpx 12rpx rgba(0,0,0,.5); }
.prule{ width:76rpx; height:1px; margin:20rpx 0 18rpx;
        background:rgba(244,237,227,.34); }
.pdesc{ display:block; font-family:var(--hand); font-size:34rpx; line-height:1.9;
        letter-spacing:.03em;
        color:rgba(244,237,227,.94); text-align:justify;
        text-shadow:0 1rpx 8rpx rgba(0,0,0,.44); }

/* ── 书架 ──────────────────────────────────────────────────
   牌立在板上，一层三张。今天那张微微抽出来一点。
   板是一道有厚度的横线加它下面的影——不画木纹，那会变成拟物。 */
.shelf{ margin:24rpx 0 0; }
.srow{ display:flex; align-items:flex-end; gap:16rpx; padding:0 6rpx; }
.spine{ flex:1; height:190rpx; border-radius:8rpx 8rpx 3rpx 3rpx;
        position:relative; overflow:hidden; box-sizing:border-box;
        padding:14rpx 12rpx 12rpx;
        display:flex; flex-direction:column; justify-content:flex-end;
        background:
          radial-gradient(24% 18% at 66% 40%, rgba(255,255,255,.08), transparent 72%),
          radial-gradient(20% 14% at 30% 70%, rgba(0,0,0,.14), transparent 74%),
          linear-gradient(94deg, rgba(0,0,0,.34) 0 6rpx, transparent 6rpx 14rpx),
          radial-gradient(72% 40% at 30% 12%, var(--lit), transparent 70%),
          linear-gradient(168deg, rgba(0,0,0,.10), rgba(0,0,0,.46) 100%),
          var(--deep);
        box-shadow:0 1px 0 rgba(255,255,255,.10) inset,
                   0 0 0 1px rgba(244,237,227,.09),
                   0 10rpx 16rpx -8rpx rgba(0,0,0,.7);
        opacity:.62; filter:saturate(.7);
        transition:opacity .2s ease, transform .2s ease, filter .2s ease; }
/* 记过词的那天颜色是活的；没记的那天牌还在架上，只是暗着 */
.spine.on{ opacity:1; filter:none; }
/* 今天那张抽出来一点 */
.spine.out{ transform:translateY(-14rpx); height:206rpx;
            box-shadow:0 1px 0 rgba(255,255,255,.14) inset,
                       0 0 0 1px rgba(201,160,99,.42),
                       0 16rpx 22rpx -10rpx rgba(0,0,0,.78); }
.sd{ font-size:21rpx; color:rgba(244,237,227,.6); letter-spacing:.06em; }
.sf{ font-family:var(--hand); font-size:27rpx; color:var(--paper); line-height:1.3;
     margin-top:2rpx; }
/* 隔板 */
.sboard{ height:10rpx; margin:0 0 26rpx; border-radius:2rpx;
         background:linear-gradient(180deg, #3A3026 0%, #241C15 60%, #1A150F 100%);
         box-shadow:0 8rpx 14rpx -6rpx rgba(0,0,0,.8),
                    0 1px 0 rgba(244,237,227,.10) inset; }

/* ── 星空 ──────────────────────────────────────────────────
   一颗是一晚。三档亮度，位置种子化（同一晚永远在同一处，
   否则每次进来星图都变，就不像"这些天"了）。
   不连线、不排名、不写总数——那都会变成打分。 */
.sky{ position:relative; height:640rpx; margin:22rpx 0 0; border-radius:18rpx;
      overflow:hidden; border:1px solid var(--hair2);
      /* 原来是纯暗棕黑，她说"黑得僵硬"。真的夜空有三层：
         高处偏冷的蓝紫、中间一层雾、靠地平线一点暖——那是城市的光。 */
      background:
        radial-gradient(64% 44% at 74% 10%, rgba(126,146,196,.13), transparent 70%),
        radial-gradient(96% 56% at 22% 42%, rgba(96,114,166,.08), transparent 74%),
        radial-gradient(130% 60% at 50% 112%, rgba(201,160,99,.13), transparent 64%),
        linear-gradient(178deg, #141827 0%, #101322 44%, #0C0D14 78%, #0A0A0E 100%); }
/* 触区。星点最大 13rpx，直接绑 tap 是点不到的（触区下限 44px ≈ 88rpx）。
   72rpx 是在"点得到"和"两颗星的触区不重叠"之间的折中：
   skyLayout 保证相邻两颗至少隔 0.32 格，最密的时候格宽约 170rpx。 */
.starhit{ position:absolute; width:72rpx; height:72rpx; margin:-36rpx 0 0 -36rpx;
          display:flex; align-items:center; justify-content:center; }
.star{ width:10rpx; height:10rpx; border-radius:50%;
       background:var(--paper);
       animation:twinkle 5.5s ease-in-out infinite;
       transition:box-shadow .3s ease, transform .3s cubic-bezier(.2,.8,.3,1); }
.star.d0{ opacity:.24; width:7rpx; height:7rpx; box-shadow:0 0 6rpx rgba(244,237,227,.24); }
.star.d1{ opacity:.55; box-shadow:0 0 10rpx rgba(244,237,227,.42); }
.star.d2{ opacity:.95; width:13rpx; height:13rpx;
          box-shadow:0 0 18rpx rgba(244,237,227,.75), 0 0 34rpx rgba(201,160,99,.28); }
/* 选中的那一颗：只加一圈光，不改大小档位——大小是那一晚的亮度，不能被"选中"覆盖 */
.star.on{ transform:scale(1.5);
          box-shadow:0 0 22rpx rgba(244,237,227,.9), 0 0 46rpx rgba(201,160,99,.4); }
/* nth-child 挪到触区上：.star 现在是 .starhit 的独生子，挂在它身上永远只命中 3n+1 */
.starhit:nth-child(3n)   .star{ animation-delay:1.8s }
.starhit:nth-child(3n+1) .star{ animation-delay:3.4s }
@keyframes twinkle{ 0%,100%{ filter:brightness(1) } 50%{ filter:brightness(1.5) } }
/* 读出那一晚。原来是屏底列最近三晚（.skyfoot）——那是个列表不是星空，
   而且只有三条，别的星星点了没反应。现在只留一行，跟着手指走。 */
.skyread{ min-height:76rpx; margin:20rpx 0 0; text-align:center;
          font-size:30rpx; letter-spacing:.06em; color:var(--paper3); }
.sk-l{ font-family:var(--hand); font-size:38rpx; color:var(--paper); }
.skyread .none{ font-size:26rpx; }

/* ── 睡眠三档 ────────────────────────────────────────────── */
.spick{ display:flex; gap:14rpx; margin:22rpx 0 0; }
.sp-b{ flex:1; min-height:104rpx; display:flex; align-items:center; justify-content:center;
       border:1px solid var(--hair); border-radius:14rpx; background:linear-gradient(168deg,#26201A,#1D1813);
       font-family:var(--disp); font-size:32rpx; color:var(--paper); text-align:center;
       transition:opacity .16s ease, transform .16s ease, border-color .2s ease; }
.sp-b.on{ border-color:rgba(201,160,99,.5); background:linear-gradient(165deg,#2E251C,#231D16); }


/* 开关。轨道 + 圆点，不用系统 switch——系统那个的绿色压不掉，
   而 PRD 说不用绿色做奖励色。开态用青玉，和「在场人数」同一个色。 */
.swrow{ display:flex; align-items:center; gap:16rpx; padding:20rpx 0;
        border-bottom:1px solid var(--hair2);
        transition:opacity .16s ease, transform .16s ease; }
.swk{ font-size:32rpx; color:var(--paper); flex:none; }
.swh{ font-size:26rpx; color:var(--paper3); flex:1; text-align:right; }
.swt{ flex:none; width:74rpx; height:42rpx; border-radius:21rpx;
      background:rgba(244,237,227,.09); border:1px solid var(--hair);
      position:relative; transition:background .22s ease, border-color .22s ease; }
.swt.on{ background:rgba(140,193,170,.26); border-color:rgba(140,193,170,.55); }
.swd{ position:absolute; left:4rpx; top:3rpx; width:32rpx; height:32rpx; border-radius:50%;
      background:var(--paper3);
      transition:transform .24s cubic-bezier(.34,.06,.2,1), background .22s ease; }
.swt.on .swd{ transform:translateX(30rpx); background:var(--jade); }

/* 警示块。PRD：唯一允许用警示色的地方是躯体安全那类信息。
   用整圈 1px 边框 + 极淡底色，不用彩色左边框——那是模板味的做法。 */
.s-warn{ margin:18rpx 0 0; padding:18rpx 24rpx 20rpx; border-radius:14rpx;
         border:1px solid rgba(203,126,98,.40); background:rgba(203,126,98,.055); }
.s-warn .wt{ display:block; font-size:26rpx; letter-spacing:.16em;
             color:var(--clay); margin-bottom:8rpx; }
.s-warn .wb{ display:block; font-size:30rpx; line-height:1.68; color:var(--paper); }

/* 长说明收起态。和 .s-q 一样是一行可点的，但更轻——它是可选的旁注不是入口 */
.swrap{ display:block; }
.sbtn{ display:inline-flex; align-items:center; gap:6rpx; margin:18rpx 0 0;
       font-size:26rpx; letter-spacing:.1em; color:var(--paper3);
       padding:10rpx 20rpx 10rpx 0; transition:opacity .16s ease, transform .16s ease; }
.s-s.open{ animation:ina .3s cubic-bezier(.22,.61,.36,1) both; }

/* 折叠入口。收起态是首屏的最后一行，字比正文小、比标签大——它是入口不是标题 */
.foldwrap{ margin-top:16rpx; }
.morebtn{ display:flex; align-items:center; justify-content:space-between;
          font-size:28rpx; letter-spacing:.14em; color:var(--paper3);
          padding:16rpx 4rpx; border-top:1px solid var(--hair2);
          transition:opacity .16s ease, transform .16s ease; }
.mchev{ transform:rotate(90deg); transition:transform .22s cubic-bezier(.22,.61,.36,1); }
.mchev.up{ transform:rotate(-90deg); }

/* ── 情绪瓶子：瓶座上一出现数量就变成计次，所以写「八月」 ────────
   几何堆叠用 px 算，这里也用 px，两边必须同一把尺子 */
.machine{ margin:32rpx 0 8rpx; display:flex; flex-direction:column; align-items:center; }
/* 玻璃罐。上一版是个正圆——正圆读作球体，不是罐子。
   罐子的三个必要条件：肩、口、平底。
   形状靠不对称的 border-radius：上方圆角小（瓶肩），下方是半圆（罐底）；
   罐口另起一层压在上沿。布局代码不用改，圆形堆叠仍然落在这个形状里面。 */
.glass{ position:relative; width:250px; height:250px;
  border-radius:40% 40% 50% 50% / 32% 32% 50% 50%;
  overflow:hidden;
  background:
    radial-gradient(44% 30% at 30% 16%, rgba(244,237,227,.09), transparent 66%),
    radial-gradient(36% 20% at 50% 97%, rgba(201,160,99,.11), transparent 76%),
    radial-gradient(120% 100% at 50% 4%, #2C251D 0%, #17130F 56%, #0C0A08 100%);
  box-shadow:
    inset 0 0 0 1px rgba(244,237,227,.11),
    inset 0 0 26px rgba(0,0,0,.52),
    inset 0 8px 16px -6px rgba(244,237,227,.06),
    0 26px 46px -22px rgba(0,0,0,.9),
    0 0 40px -12px rgba(201,160,99,.10); }

/* 罐口。上一版是一块深色横条，读作木塞。玻璃翻边的读法是：
   同罐身一个色系、上下各一道亮线（翻边的两个转折面）、两端略暗（弧度）。 */
.neck{ width:150px; height:13px; margin:0 auto -6px; position:relative; z-index:4;
  border-radius:7px 7px 2px 2px;
  background:linear-gradient(180deg,
    rgba(244,237,227,.16) 0%, rgba(244,237,227,.04) 22%,
    #221C16 55%, #1A1511 100%),
    linear-gradient(90deg, rgba(0,0,0,.5) 0%, transparent 14%, transparent 86%, rgba(0,0,0,.5) 100%);
  box-shadow:inset 0 1px 0 rgba(244,237,227,.26),
             inset 0 -1px 0 rgba(0,0,0,.55),
             0 2px 6px -2px rgba(0,0,0,.65); }

/* 玻璃本身：两道竖直侧壁反光 + 顶部透光 + 一圈厚度暗角。盖在球上面，不接手势。
   侧壁那两道竖线是"这是玻璃"最省的信号——圆形的高光块只能读成塑料。 */
.gloss{ position:absolute; left:0; top:0; right:0; bottom:0;
  border-radius:40% 40% 50% 50% / 32% 32% 50% 50%;
  pointer-events:none; z-index:3;
  background:
    linear-gradient(90deg, transparent 5%, rgba(244,237,227,.11) 11%, rgba(244,237,227,.02) 17%, transparent 22%),
    linear-gradient(90deg, transparent 80%, rgba(244,237,227,.06) 88%, transparent 94%),
    radial-gradient(38% 20% at 32% 9%, rgba(244,237,227,.13), transparent 72%);
  box-shadow: inset 0 0 22px rgba(0,0,0,.32); }

/* 珠子画在 canvas 里，铺满罐子。玻璃层（.gloss）盖在它上面。
   删掉的是上一版的 .ball 与那五组关键帧（dfall / dsquash / droll /
   bumphit / bumpsettle）加上 .glass.hit：那套是"播一条事先算好的轨迹"，
   而重力方向每帧都可能变（跟着手机晃），轨迹算不出来。
   现在每帧的位置由 data/jar.js 的 step() 解，画法在同一个文件的 sprite()。 */
.jarcv{ position:absolute; left:0; top:0; width:100%; height:100%; z-index:2; }

/* 纸标签。上一版是金色渐变底座，那读作奖杯；一张米白的纸标签读作
   自家封的果酱罐——温度是从这种材质来的，不是从更多光效来的。 */
.base{ width:118px; margin:-4px auto 0; padding:5px 0 6px; position:relative; z-index:4;
  border-radius:2px;
  background:linear-gradient(176deg, #D9CFBE 0%, #CBC0AC 62%, #BEB29C 100%);
  box-shadow:0 3px 7px -3px rgba(0,0,0,.55), inset 0 1px 0 rgba(255,255,255,.35);
  display:flex; align-items:center; justify-content:center; }
.base text{ font-family:var(--hand); font-size:25rpx; font-weight:500; color:#4A3B28;
            letter-spacing:.14em; }
.readout{ min-height:80rpx; margin:26rpx 0 0; text-align:center;
          font-family:var(--disp); font-size:32rpx; line-height:1.7; color:var(--paper2); }
.readout .none{ color:var(--paper3); font-size:26rpx; }
.rd-day{ font-size:25rpx; letter-spacing:.14em; color:var(--paper3); }
/* 主题词是这一屏唯一的大字。楷体：它是那一天的名字，不是一条数据 */
.rd-theme{ font-family:var(--hand); font-size:60rpx; line-height:1.45; margin-top:2rpx; }
.rd-non{ font-family:var(--body); font-size:30rpx; color:var(--paper3); }
.rd-open{ display:inline-block; margin-top:12rpx; padding:8rpx 6rpx 10rpx;
          font-size:27rpx; letter-spacing:.12em; color:var(--paper2);
          border-bottom:1px solid var(--hair); }

/* ── 展开看看：一阵云雾，雾散了纸条在下面 ──────────────────────
   雾不用 filter:blur —— 那在旧安卓 WebView 上要么不生效要么整块掉帧。
   三团 radial-gradient 本身就是软边，各自的大小和飘散方向不同，
   叠起来就不像"一个圆在放大"。 */
.slipwrap{ position:relative; margin:20rpx 0 6rpx; }
.fog{ position:absolute; left:-6%; right:-6%; top:-26rpx; bottom:-26rpx;
      pointer-events:none; z-index:2; overflow:hidden; }
.pf{ position:absolute; border-radius:50%;
     background:radial-gradient(circle at 50% 50%,
       rgba(244,237,227,.46) 0%, rgba(244,237,227,.16) 42%, rgba(244,237,227,0) 72%);
     animation-name:fogout; animation-fill-mode:both;
     animation-timing-function:cubic-bezier(.22,.62,.3,1); }
.pf1{ left:2%;  top:6%;  width:62%; height:86%; animation-duration:.94s; }
.pf2{ left:34%; top:-4%; width:58%; height:96%; animation-duration:1.08s; animation-delay:.05s; }
.pf3{ left:16%; top:22%; width:70%; height:74%; animation-duration:.86s; animation-delay:.11s; }
@keyframes fogout{
  0%   { opacity:0;   transform:scale(.62) translateY(16rpx) }
  24%  { opacity:.92; transform:scale(1)   translateY(0) }
  100% { opacity:0;   transform:scale(1.55) translateY(-40rpx) }
}
/* 纸条。米白纸 + 楷体 + 一点点歪——歪是"随手撕下来的"唯一信号，
   正着放就变回一张卡片了。压在雾底下，雾散的同时浮上来。 */
.slip{ position:relative; z-index:1; padding:26rpx 32rpx 30rpx;
  background:linear-gradient(176deg, #EFE6D6 0%, #E5DAC7 60%, #DBCFB8 100%);
  border-radius:3rpx;
  box-shadow:0 16rpx 28rpx -14rpx rgba(0,0,0,.72), inset 0 1px 0 rgba(255,255,255,.5);
  animation:slipin .82s .2s cubic-bezier(.2,.7,.3,1) both; }
@keyframes slipin{
  0%   { opacity:0; transform:rotate(-1.4deg) translateY(30rpx) scale(.965) }
  100% { opacity:1; transform:rotate(-.7deg)  translateY(0)     scale(1) }
}
/* 六行 = 六格。空的那几行也在，虚线照旧 —— 空格不是失分 */
.sl-row{ display:flex; align-items:center; min-height:56rpx;
         border-bottom:1px dashed rgba(74,59,40,.18); }
.sl-n{ width:30rpx; font-family:var(--mono); font-size:21rpx; color:rgba(74,59,40,.42); }
.sl-dot{ width:20rpx; height:20rpx; border-radius:50%; margin-right:16rpx;
         background:rgba(74,59,40,.10);
         box-shadow:inset 0 1px 2px rgba(0,0,0,.22), 0 1px 0 rgba(255,255,255,.4); }
.sl-w{ font-family:var(--hand); font-size:34rpx; letter-spacing:.05em; color:#3B2F21; }
.sl-row.off .sl-dot{ box-shadow:inset 0 0 0 1px rgba(74,59,40,.16); background:transparent; }
.sl-sum{ margin-top:20rpx; padding-top:18rpx; border-top:1px solid rgba(74,59,40,.24);
  font-family:var(--hand); font-size:32rpx; line-height:1.82; color:#4A3B28;
  text-align:justify; }

/* view 没有 :hover，点击反馈用 hover-class。
   transition 必须写在基类上：hover-class 是按下时追加、松手就移除，
   写在 .tap 里松手那一下类已经没了，回弹会是硬切。 */
.s-q, .s-b, .navbtn, .cells, .word, .player, .pickbtn, .footbtn{
  transition: opacity .16s ease, transform .16s ease; }
.tap{ opacity:.62; transform:scale(.978); }

/* 换屏：整屏轻微上浮淡入。两套同内容的 keyframes 由 seq 奇偶轮换——
   同名 animation 在 class 不变时不会重播，轮换是让它每屏都重放的最省办法。 */
@keyframes ina{ from{ opacity:0; transform:translateY(10rpx) } to{ opacity:1; transform:none } }
@keyframes inb{ from{ opacity:0; transform:translateY(10rpx) } to{ opacity:1; transform:none } }
.in0{ animation:ina .34s cubic-bezier(.22,.61,.36,1) both; }
.in1{ animation:inb .34s cubic-bezier(.22,.61,.36,1) both; }
.chev{ color:var(--paper3); font-size:30rpx; flex:none; }

/* ── 松紧（冥想屏）：用力一下再松开。一轮七秒。
   松开的那一段占三分之二——渐进放松的作用全在"松开之后的那几秒"，
   所以动画时间也该给它。
   形状用圆角方、动作是收紧，和呼吸圆的胀缩区分开：
   一个是气在进出，一个是肌肉在放手。 ─────────────────────── */
.relax{ position:relative; width:246px; height:246px; display:flex;
        align-items:center; justify-content:center; margin:36rpx auto 20rpx; }
.relax .rx-out, .relax .rx-mid, .relax .rx-core{
  position:absolute; border-radius:34px;
  animation:tighten 7s cubic-bezier(.34,.06,.2,1) infinite; }
.relax .rx-out{ width:214px; height:214px;
  background:radial-gradient(58% 58% at 42% 36%, rgba(201,160,99,.11), rgba(201,160,99,0) 72%); }
.relax .rx-mid{ width:150px; height:150px; border-radius:26px;
  border:1px solid rgba(201,160,99,.30); animation-delay:.12s; }
.relax .rx-core{ width:96px; height:96px; border-radius:20px;
  background:linear-gradient(158deg, rgba(224,191,140,.34), rgba(201,160,99,.12) 62%, rgba(201,160,99,0));
  box-shadow:0 0 38px -8px rgba(201,160,99,.26); animation-delay:.06s; }
@keyframes tighten{
  0%   { transform:scale(1);   opacity:.66 }
  20%  { transform:scale(.86); opacity:1 }    /* 用力，一点四秒 */
  34%  { transform:scale(.86); opacity:1 }    /* 停一拍 */
  86%  { transform:scale(1);   opacity:.66 }  /* 松开，四点六秒——最长的一段 */
  100% { transform:scale(1);   opacity:.66 }
}
.rx-cue{ position:relative; z-index:2; font-size:26rpx; letter-spacing:.3em;
         color:var(--brass); }
.rx-cue text{ animation:rxcue 7s linear infinite; }
.rx-cue .loose{ animation-name:rxloose; }
@keyframes rxcue{ 0%{opacity:0} 6%{opacity:.9} 30%{opacity:.9} 40%{opacity:0} 100%{opacity:0} }
@keyframes rxloose{ 0%{opacity:0} 42%{opacity:0} 50%{opacity:.9} 88%{opacity:.9} 100%{opacity:0} }

/* ── 呼吸：吸四拍、停一拍、呼六拍。一轮十一秒。
   呼比吸长——那是降低生理唤起的那一半，不是装饰。
   尺寸用 px：圆形和瓶子一样，两边必须同一把尺子。 ─────────────── */
.breath{ position:relative; width:246px; height:246px; display:flex;
         align-items:center; justify-content:center; margin:36rpx auto 20rpx; }
.breath .core, .breath .ring, .breath .halo{
  position:absolute; border-radius:50%;
  animation:inout 11s cubic-bezier(.42,0,.58,1) infinite; }
.breath .halo{ width:246px; height:246px; filter:blur(2px);
  background:radial-gradient(circle, rgba(140,193,170,.16) 0%, rgba(140,193,170,0) 68%); }
.breath .ring{ width:172px; height:172px; border:1px solid rgba(140,193,170,.34); }
.breath .core{ width:130px; height:130px;
  background:radial-gradient(circle at 38% 32%, rgba(180,222,205,.42), rgba(120,172,152,.16) 52%, rgba(120,172,152,0) 78%);
  box-shadow:0 0 46px -6px rgba(140,193,170,.30); }
@keyframes inout{
  0%   { transform:scale(.80); opacity:.62 }
  36%  { transform:scale(1.10); opacity:1 }    /* 吸到顶，四拍 */
  45%  { transform:scale(1.10); opacity:1 }    /* 停一拍 */
  100% { transform:scale(.80); opacity:.62 }   /* 呼六拍 */
}
/* 一圈圈荡开的涟漪，每 3.6 秒一次 */
.ripple{ position:absolute; width:172px; height:172px; border-radius:50%;
         border:1px solid rgba(140,193,170,.22); animation:out 11s ease-out infinite; }
.ripple.r2{ animation-delay:3.6s }
.ripple.r3{ animation-delay:7.2s }
@keyframes out{
  0%{ transform:scale(.82); opacity:0 }
  18%{ opacity:.5 }
  100%{ transform:scale(1.46); opacity:0 }
}
/* 吸 / 呼 两个字交替淡入，和缩放同一节拍 */
.cue{ position:absolute; inset:0; }
.cue text{ position:absolute; left:0; right:0; top:0; bottom:0;
  display:flex; align-items:center; justify-content:center;
  font-family:var(--disp); font-size:38rpx; letter-spacing:.34em;
  color:var(--jade); animation:cue 11s linear infinite; }
.cue .out{ animation-name:cueout }
@keyframes cue{ 0%{opacity:0} 8%{opacity:.9} 34%{opacity:.9} 44%{opacity:0} 100%{opacity:0} }
@keyframes cueout{ 0%{opacity:0} 48%{opacity:0} 56%{opacity:.9} 92%{opacity:.9} 100%{opacity:0} }

/* 在场指示：一个 4.5 秒一次的青玉小点。「正在吃」那屏用的是这个，不是潮汐 */
.pulse{ display:inline-block; width:12rpx; height:12rpx; border-radius:50%;
        background:var(--jade); box-shadow:0 0 20rpx var(--jade);
        animation:pulse 4.5s ease-in-out infinite; margin-right:12rpx; }
@keyframes pulse{ 0%,100%{opacity:.5; transform:scale(1)} 50%{opacity:1; transform:scale(1.3)} }

/* ── 滋味卡：设计画布把「今天的滋味 / 品名 / 描述 / 开口」连材质条包成一张卡 ── */
.tcard{ border:1px solid var(--hair); border-radius:14rpx; overflow:hidden; margin:24rpx 0 0; }
.mat{ position:relative; height:236rpx; overflow:hidden; }
.matcv{ display:block; width:100%; height:100%; }
.tbody{ background:var(--n2); padding:30rpx 38rpx 34rpx;
        display:flex; flex-direction:column; gap:18rpx; }
.tbody .s-ti{ margin:0; font-size:26rpx; }
.tbody .s-food{ margin:0; }
.tbody .tp{ margin:0; line-height:1.88; }
.topen{ font-size:28rpx; color:var(--paper3); padding-top:4rpx; }

/* 热气：只在白天出现——文案里写着「很烫」，那就让它烫。
   ponytail: 原设计是三条 bezier + 高斯模糊，canvas 里要每帧重画；
   这里用三条 CSS 动画的细条近似，形不同但"烫"在。要真曲线就改 canvas 逐帧。 */
.steam{ position:absolute; left:0; right:0; top:0; bottom:0; }
.sm{ position:absolute; bottom:36%; width:3rpx; height:56rpx; border-radius:3rpx;
     background:linear-gradient(180deg, rgba(244,237,227,0), rgba(244,237,227,.40));
     animation:steam 7.5s ease-out infinite; }
.s1{ left:27% } .s2{ left:51%; animation-delay:2.4s } .s3{ left:74%; animation-delay:4.7s }
@keyframes steam{
  0%{ opacity:0; transform:translateY(12rpx) scaleX(1) }
  22%{ opacity:.5 }
  70%{ opacity:.22 }
  100%{ opacity:0; transform:translateY(-52rpx) scaleX(1.6) }
}

/* ── 我写的滋味 ───────────────────────────────────────────
   五个角度的填写、以前写过的几条、别人写的。
   ⚠️ 这一段刻意没有：进度条、完成度、第几条、任何计数。
      计数就是打卡，而这一层正要摆脱打卡。 */

.asp{ margin:24rpx 0 0; }
.asp-row{ display:flex; align-items:baseline; gap:20rpx; flex-wrap:wrap;
          border-bottom:1px solid var(--hair2); padding:22rpx 0; }
/* 角度名用衬线，和品名同族——它问的是食物，不是问她 */
.asp-k{ font-family:var(--disp); font-size:32rpx; color:var(--paper);
        flex:none; width:88rpx; }
.asp-in{ flex:1; min-width:0; font-size:32rpx; line-height:1.6; color:var(--paper);
         padding:4rpx 0; }
.asp-ph{ color:var(--paper3); font-size:28rpx; }
/* 那一句提示。缩进对齐输入框、字比正文小，不用红色不用图标——
   它是一句说明，不是一次报错。 */
.asp-say{ width:100%; padding-left:108rpx; font-size:26rpx; line-height:1.7;
          color:var(--paper3); margin-top:10rpx; }
.asp-ok{ margin:40rpx 0 0; text-align:center; font-size:30rpx; letter-spacing:.08em;
         border:1px solid var(--hair2); border-radius:12rpx; padding:24rpx 0;
         color:var(--paper2);
         transition:border-color .2s ease, background .2s ease; }
.asp-ok.tap{ border-color:rgba(201,160,99,.5); background:rgba(201,160,99,.07); }

/* 以前写过的几条。日期在前、字小且暗——变化靠日期看出来，不靠标注。 */
.past{ display:flex; align-items:baseline; gap:20rpx; padding:18rpx 0;
       border-bottom:1px solid var(--hair2); }
.past-at{ font-size:26rpx; color:var(--paper3); flex:none; width:140rpx; }
.past-t{ font-size:30rpx; line-height:1.75; color:var(--paper2); flex:1; }

/* 别人写的。和 .past 同一套排版——那是有意的：
   别人的句子和她自己的句子在视觉上等价，没有谁更权威。 */
.oth{ margin:20rpx 0 0; }
.oth-row{ display:flex; align-items:baseline; gap:20rpx; padding:22rpx 0;
          border-bottom:1px solid var(--hair2); }
.oth-at{ font-size:26rpx; color:var(--paper3); flex:none; width:140rpx; }
.oth-t{ font-size:30rpx; line-height:1.75; color:var(--paper2); flex:1; }

/* ── 四个人 ──────────────────────────────────────────────
   ⚠️ 这一段刻意没有：头像、排名、推荐标记、「最适合你的」、转圈、进度。
      排名就是评价，而四个人是并列的。 */

.mens{ margin:24rpx 0 0; }
.men{ padding:26rpx 0; border-bottom:1px solid var(--hair2); }
.men-h{ display:flex; align-items:baseline; gap:16rpx; }
/* 名字用衬线、和品名同族——这四个是产品自己的声音，不是外挂的人物 */
.men-n{ font-family:var(--disp); font-size:36rpx; color:var(--paper); }
.men-g{ font-size:26rpx; color:var(--paper3); letter-spacing:.06em; }
.men-i{ display:block; font-size:30rpx; line-height:1.75; color:var(--paper2);
        margin-top:12rpx; }
/* 他会怎么说。字更小更暗——她扫一眼就知道找谁，不用读完 */
.men-l{ display:block; font-size:26rpx; line-height:1.8; color:var(--paper3);
        margin-top:10rpx; text-align:justify; }

/* 说点什么 */
.mif{ margin:24rpx 0 0; }
.mif-in{ width:100%; min-height:180rpx; font-size:32rpx; line-height:1.75;
         color:var(--paper); padding:20rpx 0;
         border-bottom:1px solid var(--hair2); }
.mif-ph{ color:var(--paper3); font-size:30rpx; }

/* ── 聊 ──────────────────────────────────────────────────
   她说的靠右、无框；他们说的靠左带名字。
   ⚠️ 不做气泡——气泡是聊天软件的语言，这里不是社交产品。
      靠对齐和留白分辨谁在说，比两种颜色的气泡安静。 */
.chat{ margin:8rpx 0 0; padding-bottom:180rpx; }
.chat-to{ font-size:26rpx; color:var(--paper3); letter-spacing:.06em;
          padding:12rpx 0 20rpx; }
/* ⚠️ 四个人的话之间留够气。原来 34rpx，四段挤成一片文字砖——
   那正是「同样大小的卡片堆叠」那个毛病（8-22 骂过的"太死板 AI"的头号来源）。
   名字前面留 44rpx，段内行距压到 1.75，靠"段间大、段内小"把四段分开。 */
.msg{ margin:0 0 8rpx; padding-top:44rpx; }
.msg:first-child{ padding-top:8rpx; }
.msg-w{ display:flex; align-items:baseline; gap:14rpx; margin-bottom:14rpx; }
.msg-n{ font-family:var(--disp); font-size:32rpx; color:var(--paper); }
.msg-g{ font-size:24rpx; color:var(--paper3); }
/* ⚠️ 不 justify。两端对齐会把短句拉出难看的字距，
   而这四段刻意长短不一——地面常常只有一句。 */
.msg-t{ display:block; font-size:30rpx; line-height:1.75; color:var(--paper2); }
/* 她说的：靠右、缩进、更亮——那是她的话，视觉上要一眼分得出 */
.msg.mine{ padding-left:120rpx; padding-top:36rpx; }
.msg.mine .msg-t{ color:var(--paper); text-align:right; font-size:31rpx; }

/* 还在等谁。只有名字，没有「正在输入」也没有点点点——
   那些都是在说「你等着」。 */
.chat-wait{ font-size:26rpx; color:var(--paper3); letter-spacing:.1em;
            padding:6rpx 0 20rpx; }

.chat-pick{ margin:20rpx 0 0; padding-top:22rpx; border-top:1px solid var(--hair2); }
.chat-pl{ font-size:26rpx; color:var(--paper3); }
.chat-ps{ display:flex; gap:14rpx; margin-top:16rpx; flex-wrap:wrap; }
.chat-p{ flex:1; min-width:140rpx; text-align:center; font-size:29rpx;
         border:1px solid var(--hair2); border-radius:12rpx; padding:18rpx 8rpx;
         color:var(--paper2); transition:border-color .2s ease, background .2s ease; }
.chat-p.tap{ border-color:rgba(201,160,99,.5); background:rgba(201,160,99,.07); }

/* 输入框吸底 */
.chat-bar{ position:fixed; left:0; right:0; bottom:0; display:flex; gap:16rpx;
           align-items:center; padding:22rpx 48rpx calc(28rpx + env(safe-area-inset-bottom));
           background:var(--n1); border-top:1px solid var(--hair2); }
.chat-in{ flex:1; min-width:0; font-size:31rpx; color:var(--paper); padding:14rpx 0; }
.chat-send{ flex:none; font-size:30rpx; color:var(--paper2); padding:14rpx 26rpx;
            border:1px solid var(--hair2); border-radius:12rpx; }
.chat-send.tap{ border-color:rgba(201,160,99,.5); background:rgba(201,160,99,.07); }
.chat-foot{ font-size:26rpx; color:var(--paper3); padding:26rpx 0 0; }
/* 「在想」。⚠️ 不做点点点动画，不做骨架屏——
   那些都在说「你等着」，而且动画本身也是抖。就一个词，静的。 */
.msg-p{ font-size:28rpx; color:var(--paper3); letter-spacing:.2em; }
